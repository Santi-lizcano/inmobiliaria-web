# es buena práctica ignorarlo y dejar un db.properties.example
# src/main/resources/db.properties
# src/main/resources/db-local.properties

# ==========================================
# UPLOADS DE USUARIOS
# ==========================================
# Ignoramos las imágenes subidas, pero conservamos
# la carpeta gracias al .gitkeep
src/main/webapp/uploads/propiedades/*
!src/main/webapp/uploads/propiedades/.gitkeep

